// Layout and click actions. Build the hover mixer with mixer/build.sh.
{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 4,
  "fixed-center": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/launcher",
    "ext/workspaces",
    "hyprland/submap"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/hardware",
    "custom/expressvpn",
    "network",
    "cffi/audio-mixer",
    "battery",
    "idle_inhibitor",
    "tray",
    "custom/notifications",
    "custom/help",
    "custom/power"
  ],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "Applications · Super + R",
    "on-click": "rofi -show drun -show-icons"
  },
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true
  },
  "hyprland/submap": {
    "format": "{}",
    "tooltip": false
  },
  "clock": {
    "format": "{:%a %d %b  ·  %H:%M}",
    "format-alt": "{:%A, %d %B %Y · %I:%M %p}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>\n<small>Scroll over the clock: previous / next month</small>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span color='#7dd3c7'><b>{}</b></span>"
      },
      "on-scroll": 1
    },
    "actions": {
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    }
  },
  "group/hardware": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 180,
      "children-class": "hardware-detail"
    },
    "modules": [
      "cpu",
      "memory",
      "custom/cpu-temperature",
      "custom/gpu-temperature"
    ]
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "tooltip-format": "CPU: {usage}% · load {load}\nHover for RAM and temperatures\nClick: system monitor",
    "on-click": "kitty --title btop -e btop"
  },
  "memory": {
    "interval": 10,
    "format": " {percentage}%",
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB\nClick: system monitor",
    "on-click": "kitty --title btop -e btop"
  },
  "custom/cpu-temperature": {
    "exec": "python3 \"$HOME/.config/waybar/scripts/temperature.py\" cpu",
    "return-type": "json",
    "interval": 10,
    "format": "{}"
  },
  "custom/gpu-temperature": {
    "exec": "python3 \"$HOME/.config/waybar/scripts/temperature.py\" gpu",
    "return-type": "json",
    "interval": 10,
    "format": "{}"
  },
  "custom/expressvpn": {
    "exec": "\"$HOME/.config/waybar/expressvpn.sh\"",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "escape": true,
    "on-click": "\"$HOME/.config/waybar/expressvpn.sh\" toggle",
    "on-click-right": "\"$HOME/.config/waybar/expressvpn.sh\" change-region"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "Wi-Fi · {signalStrength}% signal\nClick: connection settings",
    "tooltip-format-ethernet": "Ethernet connected\nClick: connection settings",
    "tooltip-format-disconnected": "Network disconnected\nClick: connection settings",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 Full",
    "format-icons": [
      "󰂎",
      "󰁻",
      "󰁾",
      "󰂁",
      "󰁹"
    ],
    "tooltip-format": "{capacity}% · {timeTo}\nPower: {power:0.1f} W"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Stay awake is ON · click to allow idle lock / sleep",
    "tooltip-format-deactivated": "Automatic idle lock / sleep · click to stay awake"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "restart-interval": 5
  },
  "custom/help": {
    "format": "󰋖",
    "tooltip-format": "Keyboard shortcuts · Super + /",
    "on-click": "\"$HOME/.config/hypr/scripts/shortcuts.sh\""
  },
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power menu: Lock · Sleep · Shutdown · Reboot\nRight-click: lock screen",
    "on-click": "\"$HOME/.config/waybar/scripts/power-menu.sh\"",
    "on-click-right": "pidof hyprlock || hyprlock"
  },
  // Maximum for both master and per-app sliders (100–200%).
  "cffi/audio-mixer": {
    "max-volume": 150
  },
  "include": [
    "~/.config/waybar/mixer/module.local.json"
  ]
}
