# Personal overrides and credentials: keep them out of the dotfiles repository.
.env
.env.*
!.env.example
**/local.lua
**/*.local.conf
**/credentials*
**/secrets*
*.pem
*.key
id_rsa*
id_ed25519*

# Backups, editor state, logs, and generated files.
*.backup*
*.bak
*~
*.swp
*.swo
*.log
__pycache__/
*.py[cod]
.cache/
.DS_Store
.vscode/
